# Environment Configuration for "ನನ್ನ ಟೈಲರಿಂಗ್ ಖಾತೆ" (My Tailoring Account Book)

PROJECT_NAME="ನನ್ನ ಟೈಲರಿಂಗ್ ಖಾತೆ"
API_V1_STR="/api/v1"
ENVIRONMENT="development"

# Security & Authentication
SECRET_KEY="replace-with-a-very-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=43200 # 30 days for mobile convenience

# Database Configuration:
# For Local Oracle SQL:
DATABASE_URL="oracle+oracledb://system:varudbms@"
# For MySQL (Production / Cloud / Local MySQL):
# DATABASE_URL="mysql+pymysql://root:your_mysql_password@localhost:3306/stitchly_db?charset=utf8mb4"

# CORS configuration (comma-separated origins)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,https://my-tailoring-account.vercel.app"
